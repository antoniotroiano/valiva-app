{
  "name": "valiva",
  "private": true,
  "version": "0.0.0",
  "description": "Private retirement and savings planner (ETF savings plan, statutory pension, bAV, retirement depot, savings goals, household)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev -w @valiva/web",
    "build": "npm run build -w @valiva/web",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  }
}
